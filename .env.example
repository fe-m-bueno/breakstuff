# OpenRouter key. Required: without it /api/breakdown returns 503 and the
# breakdown action reports that the server is not configured.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Overrides the default model (poolside/laguna-s-2.1:free).
# Any tool-capable OpenRouter model works. The route forces a tool call rather
# than using response_format, so `tools` is the only capability required, but
# check before switching:
#   curl -s https://openrouter.ai/api/v1/models \
#     | jq '.data[] | select(.id=="<model>") | .supported_parameters'
# OPENROUTER_MODEL=poolside/laguna-s-2.1:free
